@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark me-2">Ciao, <strong>@User.Identity?.Name</strong>!</span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("MenuStructure", "MenuStructure", new { area = "" })">
                <button type="submit" class="nav-link auth-btn btn-login">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link btn-login-clean" asp-area="Identity" asp-page="/Account/Login">Accedi</a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn-register-laser" asp-area="Identity" asp-page="/Account/Register">Registrati</a>
        </li>
    }
</ul>
@model Linea_Produzione.Models.DistintaBaseSearchModel
@{
    ViewData["Title"] = "Gestione Distinte Base";
    Layout = "_TwoColumnsLayout";
}

@section Sidebar {
    <div id="sidebarContent" class="w-100">
        <form id="searchForm" autocomplete="off">
            <input type="hidden" asp-for="IdUtente" />

            <div class="d-flex gap-2 mb-4">
                <button type="submit" id="btnCerca" class="btn btn-primary flex-grow-1 btn-sm"><i class="bi bi-search"></i> Cerca</button>
                <button type="button" id="btnCancella" class="btn btn-outline-danger flex-grow-1 btn-sm"><i class="bi bi-eraser"></i> Cancella</button>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="toggleSidebar()"><i id="toggleIcon" class="bi bi-chevron-left"></i></button>
            </div>
            <div id="sidebarFields">
                <h5 class="mb-3 border-bottom pb-2">Filtri di Ricerca</h5>

                <div class="mb-3">
                    <label asp-for="Codice" class="form-label fw-bold mb-1">Codice</label>
                    <input asp-for="Codice" class="form-control" placeholder="Inserisci codice...">
                </div>

                <div class="mb-3">
                    <label asp-for="Versione" class="form-label fw-bold mb-1">Versione</label>
                    <input asp-for="Versione" class="form-control" placeholder="Es. 01 o v01...">
                </div>

                <div class="mb-3">
                    <label asp-for="Descrizione" class="form-label fw-bold mb-1">Descrizione</label>
                    <textarea asp-for="Descrizione" class="form-control" rows="3" placeholder="Inserisci descrizione..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="DataInizio" class="form-label fw-bold mb-1">Data inizio</label>
                    <input asp-for="DataInizio" type="date" class="form-control">
                </div>

                <div class="mb-3">
                    <label asp-for="Stato" class="form-label fw-bold mb-1">Stato Distinta</label>
                    <select asp-for="Stato" class="form-select">
                        <option value="NonArchiviati" selected>Non Archiviati</option>
                        <option value="Archiviati">Archiviati</option>
                        <option value="Creati">Creati (Created)</option>
                        <option value="Modificati">Modificati (Modified)</option>
                        <option value="Completati">Completati (Completed)</option>
                        <option value="None">Mostra Tutti (Nessun Filtro)</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
}

@section Content {
    @* =========================================================================
   TOOLBAR CON DISPOSIZIONE ORIGINALE (Nuovo a SX, Titolo al Centro, Comandi a DX)
   ========================================================================= *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">

        <div>
            <button type="button" class="btn btn-primary btn-sm px-3" onclick="apriPopupNuovo(@Model.IdUtente)">
                <i class="bi bi-plus-circle me-1"></i> Nuovo
            </button>
        </div>

        <div class="text-center">
            <div class="modern-tech-badge">
                <i class="bi bi-table text-primary"></i>
                <span>Elenco Distinte Base</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="button" id="btnModifica" class="btn btn-primary btn-sm px-3" disabled>
                <i class="bi bi-pencil-square me-1"></i> Modifica
            </button>
            <button type="button" id="btnElimina" class="btn btn-danger btn-sm px-3" disabled>
                <i class="bi bi-trash me-1"></i> Elimina
            </button>
        </div>
    </div>

    <div class="table-responsive bg-white border rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col" style="width: 140px;">Codice</th>
                    <th scope="col" style="width: 100px;">Versione</th>
                    <th scope="col">Descrizione</th>
                    <th scope="col" style="width: 140px;">Data Inizio</th>
                    <th scope="col" style="width: 120px;">Stato</th>
                </tr>
            </thead>
            <tbody id="gridBody"></tbody>
        </table>
    </div>

    <partial name="_DistintaBaseTabs" />

    <div class="modal fade" id="modalGenerico" tabindex="-1" aria-labelledby="modalGenericoLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-dark text-white py-2.5">
                    <h6 class="modal-title fw-semibold" id="modalGenericoLabel"></h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/grid.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>

    <script>
        let _idSelezionato = null;

        document.addEventListener("DOMContentLoaded", function () {
            const tabsContainer = document.getElementById("dettagliTabsContainer");
            const riepilogoPlaceholder = document.getElementById("riepilogoContentPlaceholder");

            // 1. Inizializzazione della Griglia
            GridManager.initSelection("gridBody", "btnModifica", "btnElimina", {
                onSelect: function (id) {
                    _idSelezionato = id;
                    tabsContainer.classList.remove("d-none");
                    riepilogoPlaceholder.innerHTML = `
                        <div class="text-center text-muted py-4">
                            <div class="spinner-border text-info spinner-border-sm me-2" role="status"></div>
                            Caricamento dati riepilogo...
                        </div>`;

                    fetch(`@Url.Action("Riepilogo", "DistintaBase")?id=${id}`)
                        .then(res => res.ok ? res.text() : Promise.reject("Impossibile caricare il riepilogo."))
                        .then(html => riepilogoPlaceholder.innerHTML = html)
                        .catch(err => riepilogoPlaceholder.innerHTML = `<div class="alert alert-danger mb-0">${err}</div>`);
                },
                onDeselect: function () {
                    _idSelezionato = null;
                    tabsContainer.classList.add("d-none");
                    riepilogoPlaceholder.innerHTML = "";
                }
            });

            // Gestione pulsante Modifica
            document.getElementById("btnModifica").addEventListener("click", function () {
                if (_idSelezionato) apriPopupModifica(_idSelezionato, @Model.IdUtente);
            });

            // Gestione pulsante Elimina (Genera l'alert localmente a zero latenza)
            document.getElementById("btnElimina").addEventListener("click", function () {
                if (_idSelezionato) apriPopupConfermaElimina(_idSelezionato);
            });

            // 2. Inizializzazione di SearchManager
            SearchManager.init({
                formId: "searchForm",
                tbodyId: "gridBody",
                btnCancellaId: "btnCancella",
                btnModificaId: "btnModifica",
                btnEliminaId: "btnElimina",
                url: `@Url.Action("Ricerca", "DistintaBase")`,
                colspan: 5,
                emptyMessage: "Nessuna distinta base corrisponde ai criteri di ricerca.",
                renderRow: function (item) {
                    let badgeClass = "bg-success";
                    if (item.stato === "Creato" || item.stato === "Created") badgeClass = "bg-warning text-dark";
                    else if (item.stato === "Archived" || item.stato === "Archiviato") badgeClass = "bg-light text-dark border";

                    return `
                    <tr data-id="${item.id}" style="cursor: pointer;">
                        <td>${item.codice}</td>
                        <td>${item.versione}</td>
                        <td>${item.descrizione}</td>
                        <td>${item.dataInizio}</td>
                        <td><span class="badge ${badgeClass}">${item.stato}</span></td>
                    </tr>`;
                }
            });

            // Caricamento asincrono iniziale
            document.getElementById('btnCerca').click();
        });

        // Generazione dinamica e apertura del popup di allert (Client-side)
        function apriPopupConfermaElimina(id) {
            const modalEl = document.getElementById('modalGenerico');

            modalEl.querySelector('.modal-title').innerHTML = `<i class="bi bi-exclamation-octagon me-2 text-danger"></i>Eliminazione Record`;
            modalEl.querySelector('.modal-body').innerHTML = `
                <div class="text-center my-3">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3.5rem;"></i>
                    </div>
                    <p class="fw-semibold text-secondary px-2" style="font-size: 1.1rem;">
                        Confermi la cancellazione della distinta base?
                    </p>
                </div>
                <div class="modal-footer justify-content-start px-0 pb-0 pt-3 border-top">
                    <button type="button" class="btn btn-danger btn-sm px-3" onclick="eseguiEliminazione(${id})">
                        <i class="bi bi-trash me-1"></i> Conferma
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 ms-auto" data-bs-dismiss="modal">
                        Annulla
                    </button>
                </div>`;

            new bootstrap.Modal(modalEl).show();
        }

        // Action reale: Chiude il popup all'istante e fa la chiamata POST al DB
        function eseguiEliminazione(id) {
            const modalEl = document.getElementById('modalGenerico');
            bootstrap.Modal.getInstance(modalEl)?.hide();

            fetch(`@Url.Action("Elimina", "DistintaBase")?id=${id}`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.ok ? res.json() : Promise.reject("Errore di risposta dal server."))
            .then(response => {
                if (response.success) {
                    document.getElementById('btnCerca').click();
                } else {
                    alert(response.message);
                }
            })
            .catch(err => alert("Errore durante la rimozione della distinta: " + err));
        }

        // Gestione Finestre Modali Standard (Nuovo/Modifica) da Server
        function gestisciPopup(url, titolo) {
            fetch(url)
                .then(res => res.ok ? res.text() : Promise.reject("Errore nel caricamento del modulo."))
                .then(htmlResponse => {
                    const modalEl = document.getElementById('modalGenerico');
                    modalEl.querySelector('.modal-title').innerHTML = titolo;
                    modalEl.querySelector('.modal-body').innerHTML = htmlResponse;
                    new bootstrap.Modal(modalEl).show();
                })
                .catch(err => alert("Impossibile aprire il popup: " + err));
        }

        function apriPopupNuovo(idUtente) {
            gestisciPopup(`@Url.Action("Nuovo", "DistintaBase")?idUtente=${idUtente}`, `<i class="bi bi-plus-circle me-2"></i>Nuova Distinta Base`);
        }

        function apriPopupModifica(id, idUtente) {
            gestisciPopup(`@Url.Action("Modifica", "DistintaBase")?id=${id}&idUtente=${idUtente}`, `<i class="bi bi-pencil-square me-2"></i>Modifica Distinta Base`);
        }

        function salvaNuovaDistinta() {
            const modalEl = document.getElementById('modalGenerico');
            const form = modalEl?.querySelector('form');
            if (!form) return alert("Errore: Modulo non trovato nel popup.");

            fetch(`@Url.Action("Salva", "DistintaBase")`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(new FormData(form))
            })
            .then(res => res.ok ? res.json() : Promise.reject("Errore di risposta dal server."))
            .then(response => {
                if (response.success) {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                    document.getElementById('btnCerca').click();
                } else {
                    alert(response.message);
                }
            })
            .catch(err => alert("Errore durante il salvataggio: " + err));
        }

        document.addEventListener("submit", function (e) {
            if (e.target && e.target.id === "formDistintaBase") {
                e.preventDefault();
                salvaNuovaDistinta();
            }
        });
    </script>
}
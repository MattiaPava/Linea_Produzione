@model Linea_Produzione.Models.DistintaBaseModel

<div class="card p-3 shadow-sm">

    <form id="formDistintaBase" asp-action="Salva" asp-controller="DistintaBase" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdUtente" />
        <input type="hidden" asp-for="ReadOnly" />
        <input type="hidden" asp-for="ShowCloseButton" />

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label asp-for="Codice" class="form-label">Codice</label>
                <input asp-for="Codice" class="form-control" type="text" disabled="@Model.ReadOnly" />
                <span asp-validation-for="Codice" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Versione" class="form-label">Versione</label>
                <input asp-for="Versione" class="form-control" type="text" disabled="@Model.ReadOnly" />
                <span asp-validation-for="Versione" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="DataInizio" class="form-label">Data Inizio</label>
                <input asp-for="DataInizio" class="form-control" type="date"
                       value="@Model.DataInizio.ToString("yyyy-MM-dd")" disabled="@Model.ReadOnly" />
                <span asp-validation-for="DataInizio" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-6">
                <label asp-for="Stato" class="form-label">Stato distinta</label>
                <select asp-for="Stato" asp-items="ViewBag.StatoOptions" class="form-select form-control" disabled="@Model.ReadOnly">
                </select>
                <span asp-validation-for="Stato" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-md-12">
                <label asp-for="Descrizione" class="form-label">Descrizione</label>
                <textarea asp-for="Descrizione" class="form-control" rows="2" disabled="@Model.ReadOnly"></textarea>
                <span asp-validation-for="Descrizione" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            @if (Model.ShowCloseButton)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Chiudi</button>
            }
            @if (!Model.ReadOnly)
            {
                <button type="button" class="btn btn-primary btn-sm" onclick="salvaNuovaDistinta()">Salva</button>
            }
        </div>
    </form>
</div>
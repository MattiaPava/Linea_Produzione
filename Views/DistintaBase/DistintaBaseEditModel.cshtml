@model Linea_Produzione.Models.DistintaBaseModel

<form id="formDistintaBase">
    <input type="hidden" asp-for="IdUtente" />

    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-2">
            <label asp-for="Id" class="form-label small mb-1">ID</label>
            <input asp-for="Id" class="form-control" readonly />
        </div>

        <div class="col-md-4">
            <label asp-for="Codice" class="form-label small mb-1">Codice</label>
            <input asp-for="Codice" class="form-control" disabled="@Model.ReadOnly" />
        </div>

        <div class="col-md-3">
            <label asp-for="Versione" class="form-label small mb-1">Versione</label>
            <input asp-for="Versione" class="form-control" disabled="@Model.ReadOnly" />
        </div>

        <div class="col-md-3">
            <label asp-for="DataInizio" class="form-label small mb-1">Data Inizio</label>
            <input asp-for="DataInizio" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" disabled="@Model.ReadOnly" />
        </div>

        <div class="col-12">
            <label asp-for="Descrizione" class="form-label small mb-1">Descrizione</label>
            <textarea asp-for="Descrizione" class="form-control" rows="2" disabled="@Model.ReadOnly"></textarea>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        @if (Model.ShowCloseButton)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Chiudi</button>
        }
        @if (!Model.ReadOnly)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="salvaNuovaDistinta()">Salva</button>
        }
    </div>
</form>
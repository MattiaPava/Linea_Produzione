@{
    ViewData["Title"] = "Home Page";
    Layout = "_TwoColumnsLayout";
}

@section Sidebar {
    <div id="sidebarContent" class="w-100">

        <div class="d-flex gap-2 mb-4">
            <button type="submit" id="btnCerca" class="btn btn-primary flex-grow-1 btn-sm">
                <i class="bi bi-search"></i> Cerca
            </button>

            <button type="reset" id="btnCancella" class="btn btn-outline-secondary flex-grow-1 btn-sm">
                <i class="bi bi-eraser"></i> Cancella
            </button>

            <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="toggleSidebar()">
                <i id="toggleIcon" class="bi bi-chevron-left"></i>
            </button>
        </div>

        <div id="sidebarFields">
            <h5 class="mb-3 border-bottom pb-2">Filtri di Ricerca</h5>

            <form method="get" action="">
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Codice</label>
                    <input type="text" name="codice" class="form-control" placeholder="Inserisci codice...">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Descrizione</label>
                    <textarea name="descrizione" class="form-control" rows="3" placeholder="Inserisci descrizione..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">Data inizio</label>
                    <input type="date" name="dataInizio" class="form-control">
                </div>
            </form>
        </div>
    </div>
}

@section Content {
    <h1 class="display-4">Contenuto Principale</h1>
    <p>Questa sezione è allineata a sinistra ed è gestita tramite la sezione <code>@@section Content</code>.</p>
}

@section Scripts {
    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById("mySidebar");
            var main = document.getElementById("myMain");
            var fields = document.getElementById("sidebarFields");
            var btnCerca = document.getElementById("btnCerca");
            var btnCancella = document.getElementById("btnCancella");
            var icon = document.getElementById("toggleIcon");

            if (sidebar.classList.contains("col-md-3")) {
                sidebar.classList.replace("col-md-3", "col-md-1");
                main.classList.replace("col-md-9", "col-md-11");

                fields.style.display = "none";
                btnCerca.style.display = "none";
                btnCancella.style.display = "none";

                icon.className = "bi bi-chevron-right";
            } else {
                sidebar.classList.replace("col-md-1", "col-md-3");
                main.classList.replace("col-md-11", "col-md-9");

                fields.style.display = "block";
                btnCerca.style.display = "block";
                btnCancella.style.display = "block";

                icon.className = "bi bi-chevron-left";
            }
        }
    </script>
}